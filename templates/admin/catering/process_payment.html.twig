{% extends 'admin/adminBase.html.twig' %}

{% block title %}Zahlung verarbeiten - {{ user.nickname }}{% endblock %}

{% block main %}
<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h1>Zahlung verarbeiten</h1>
            <p class="lead">
                Benutzer: <strong>{{ user.nickname }}</strong> 
                <small class="text-muted">({{ user.email }})</small>
            </p>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Zahlung verarbeiten</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <p class="mb-1"><strong>Aktuelles Guthaben:</strong> {{ (current_credit/100) | format_currency('EUR') }}</p>
                    </div>
                    
                    <form action="{{ path('admin_catering_process_payment', {'userId': user.uuid}) }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrf_token) }}">
                        
                        <div class="form-group">
                            <label for="payment_amount">Zahlungsbetrag (€):</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="fas fa-euro-sign"></i></span>
                                </div>
                                <input type="number" id="payment_amount" name="payment_amount" class="form-control" step="0.01" 
                                       value="0.00" min="0.01" required>
                            </div>
                            <small class="form-text text-muted">
                                Geben Sie den Betrag ein, der vollständig als Guthaben verbucht werden soll.
                            </small>
                        </div>
                        
                        <div class="form-group">
                            <label for="payment_note">Notiz:</label>
                            <textarea id="payment_note" name="payment_note" class="form-control" rows="3" 
                                      placeholder="Optionale Notiz zur Zahlung..."></textarea>
                        </div>
                        
                        <div class="form-group">
                            <button type="submit" class="btn btn-success btn-block">
                                <i class="fas fa-check-circle"></i> Zahlung verarbeiten
                            </button>
                        </div>
                    </form>
                    <div class="alert alert-secondary mt-3 mb-0">
                        <i class="fas fa-info-circle"></i> Zahlungen werden nicht mehr einzelnen Bestellungen zugeordnet, sondern direkt als Guthaben geführt.
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Transaktionshistorie</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Datum</th>
                                    <th>Beschreibung</th>
                                    <th>Betrag</th>
                                    <th>Typ</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if transactions|length > 0 %}
                                    {% for transaction in transactions %}
                                        <tr>
                                            <td>{{ transaction.timestamp|date('d.m.Y H:i') }}</td>
                                            <td>
                                                {% set displayDesc = transaction.description %}
                                                {% if displayDesc starts with 'Payment for catering order #' %}
                                                    {% set orderId = displayDesc|replace({'Payment for catering order #':''}) %}
                                                    {% set displayDesc = 'Bestellung #' ~ orderId %}
                                                {% elseif displayDesc starts with 'Refund for catering order #' %}
                                                    {% set orderId = displayDesc|replace({'Refund for catering order #':''}) %}
                                                    {% set displayDesc = 'Rückerstattung Bestellung #' ~ orderId %}
                                                {% endif %}
                                                {{ displayDesc }}
                                                {% if transaction.type == 'order_payment' and transaction.orderItemsInline %}
                                                    <div class="mt-1">
                                                        {{ transaction.orderItemsInline }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="{% if transaction.amount >= 0 %}text-success{% else %}text-danger{% endif %}">
                                                {{ (transaction.amount/100) | format_currency('EUR') }}
                                            </td>
                                            <td>
                                                {% if transaction.type == 'payment_received' %}
                                                    <span class="badge badge-success">Einzahlung</span>
                                                {% elseif transaction.type == 'order_payment' %}
                                                    <span class="badge badge-primary">Bestellung</span>
                                                {% elseif transaction.type == 'credit_adjustment' %}
                                                    <span class="badge badge-info">Anpassung</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center py-3">
                                            Keine Transaktionen vorhanden.
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
