{% extends 'admin/adminBase.html.twig' %}

{% block title %}DogTag Export - KLMS - Admin{% endblock %}
{% block siteheading %}<i class="fas fa-tags"></i> DogTag Export{% endblock %}
{% block main %}
    <div class="row mb-4">
        <div class="col-auto">
            <a class="btn btn-sm btn-secondary" href="{{ path('admin_payment') }}">
                <i class="fas fa-arrow-left"></i> Zurück zu Tickets
            </a>
        </div>
    </div>

    {% for flashMessage in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ flashMessage }}
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endfor %}

    {% for flashMessage in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ flashMessage }}
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endfor %}

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-download"></i> DogTag CSV Export</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3 mb-md-0">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <h6 class="card-title">Alle exportieren</h6>
                                    <p class="text-muted small">Exportiert alle Gamer mit zugewiesenem Ticket</p>
                                    <a href="{{ path('admin_dogtags_export_csv') }}" class="btn btn-success btn-block">
                                        <i class="fas fa-download"></i> Alle exportieren
                                    </a>
                                    <div class="mt-2 text-muted small">
                                        {{ totalUsers }} Gamer
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-4 mb-3 mb-md-0">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <h6 class="card-title">Seit letztem Export</h6>
                                    <p class="text-muted small">
                                        {% if lastExportDate %}
                                            Letzter Export: {{ lastExportDate|date('d.m.Y H:i') }}
                                        {% else %}
                                            Noch kein Export durchgeführt
                                        {% endif %}
                                    </p>
                                    {% if lastExportDate and newUsersSinceExport > 0 %}
                                        <a href="{{ path('admin_dogtags_export_csv', {since: lastExportDate|date('Y-m-d H:i:s')}) }}" class="btn btn-info btn-block">
                                            <i class="fas fa-download"></i> Exportieren
                                        </a>
                                        <div class="mt-2 text-muted small">
                                            {{ newUsersSinceExport }} neue Gamer
                                        </div>
                                    {% else %}
                                        <button class="btn btn-secondary btn-block" disabled>
                                            <i class="fas fa-download"></i> Exportieren
                                        </button>
                                        <div class="mt-2 text-muted small">
                                            0 neue Gamer
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <h6 class="card-title">Export-Zeitstempel setzen</h6>
                                    <p class="text-muted small">Zeitpunkt des letzten Exports festlegen</p>
                                    <form method="post" action="{{ path('admin_dogtags_set_exported') }}" onsubmit="return confirm('Export-Zeitstempel setzen?')">
                                        <div class="form-group">
                                            <input type="datetime-local" 
                                                   name="timestamp" 
                                                   class="form-control form-control-sm mb-2" 
                                                   value="{{ 'now'|date('Y-m-d\\TH:i') }}" 
                                                   required>
                                        </div>
                                        <button type="submit" class="btn btn-warning btn-block">
                                            <i class="fas fa-clock"></i> Zeitstempel setzen
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
