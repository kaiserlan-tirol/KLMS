    */
});
</script>

<style>
    .form-control:focus {
        outline: none;
        border-color: #007be6;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }
    
    #qr_code {
      font-size: 1.2rem;
    }
    
    /* Toast notification */
    .toast-container {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 9999;
    }
    
    .toast {
        background: rgba(0, 0, 0, 0.85);
        color: white;
        padding: 15px 25px;
        border-radius: 8px;
        margin-bottom: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        display: flex;
        align-items: center;
        animation: slideIn 0.3s, fadeOut 0.5s 9.5s;
        max-width: 350px;
        opacity: 0;
        pointer-events: none;
    }
    
    .toast.show {
        opacity: 1;
        pointer-events: auto;
    }
    
    .toast-icon {
        margin-right: 15px;
        font-size: 1.2rem;
        color: #ffcc00;
    }
    
    .toast-content {
        flex: 1;
    }
    
    .toast-title {
        font-weight: 600;
        margin-bottom: 5px;
        font-size: 1.1rem;
    }
    
    .toast-body {
        font-size: 0.9rem;
        opacity: 0.9;
    }
    
    .toast-action {
        background: #007be6;
        color: white;
        border: none;
        padding: 5px 15px;
        border-radius: 4px;
        margin-top: 8px;
        cursor: pointer;
        font-weight: 500;
        font-size: 0.9rem;
    }
    
    @keyframes slideIn {
        from {
            transform: translateX(100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }
    
    @keyframes fadeOut {
        from {
            opacity: 1;
        }
        to {
            opacity: 0;
        }
    }
    
    /* Mobile optimizations */
    @media (max-width: 768px) {
        .btn {
            font-size: 1rem;
            padding: 10px 15px;
        }
    }
</style>
{% endblock %}
