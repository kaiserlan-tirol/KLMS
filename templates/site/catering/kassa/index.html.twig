{% extends 'site/catering/kassa/base.html.twig' %}

{% block title %}QR-Code scannen - KaiserLAN Kassa{% endblock %}

{% block content %}
<div class="text-center">
    <div style="margin-bottom: 40px;">
        <i class="fas fa-qrcode" style="font-size: 8rem; color: #007be6; margin-bottom: 30px;"></i>
        <p style="color: #666; font-size: 1.6rem; margin-bottom: 40px;">
            Scanne deinen Catering QR-Code<br />
            oder gib selbst direkt ein
        </p>
    </div>
    
    <!-- Manual input form -->
    <div id="manual-input-section">
        <div style="max-width: 500px; margin: 0 auto;">
            <div style="margin-bottom: 30px;">
                <div style="position: relative; max-width: 200px;  margin: 0 auto;">
                    <input 
                        type="text" 
                        id="qr_code" 
                        name="qr_code" 
                        class="form-control" 
                        style="font-size: 2rem; padding: 15px 50px 15px 45px; border-radius: 10px; border: 2px solid #ddd; text-align: center; width: 100%; text-transform: uppercase;"
                        autocomplete="off"
                        maxlength="4"
                        minlength="4"
                        pattern="[A-Z0-9]{4}"
                        placeholder="XXXX"
                    >
                    <button type="button" id="clear-input" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #999; font-size: 1.2rem; cursor: pointer;">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div id="input-feedback" style="margin-top: 10px; font-size: 1.5rem; min-height: 20px;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Toast container for notifications -->
<div class="toast-container" id="toast-container"></div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const qrInput = document.getElementById('qr_code');
    const clearBtn = document.getElementById('clear-input');
    const feedback = document.getElementById('input-feedback');
    
    // Auto-focus the input field
    qrInput.focus();
    
    // Enable/disable submit button based on input
    qrInput.addEventListener('input', function() {
        // Convert to uppercase automatically
        this.value = this.value.toUpperCase();
        
        // Restrict to exactly 4 characters
        const value = this.value.trim();
        
        if (value.length === 0) {
            feedback.textContent = '';
            clearBtn.style.display = 'none';
        } else {
            clearBtn.style.display = 'block';
            
            // Provide feedback on input format
            if (value.length === 4) {
                feedback.innerHTML = '<span style="color: #28a745;"><i class="fas fa-qrcode"></i> QR-Code vollständig</span>';
                // Auto-submit after a short delay when 4 characters are entered
                setTimeout(() => {
                    if (this.value.trim().length === 4) {
                        submitQRCode();
                    }
                }, 300);
            } else {
                feedback.innerHTML = '<span style="color: #6c757d;"><i class="fas fa-info-circle"></i> Genau 4 Zeichen erforderlich</span>';
            }
        }
    });
    
    const resetForm = function() {
        qrInput.value = '';
        qrInput.focus();
        submitBtn.disabled = true;
        feedback.textContent = '';
        this.style.display = 'none';
    }
    // Clear input
    clearBtn.addEventListener('click', resetForm);
    
    // Handle form submission
    function submitQRCode() {
        // Convert to uppercase and trim
        const value = qrInput.value.trim().toUpperCase();
        if (!value) return;
        
        // Show loading state
        qrInput.disabled = true;
        feedback.innerHTML = '<span style="color: #4dacff;"><i class="fas fa-search"></i> Benutzer wird gesucht...</span>';
        
        // Submit to QR lookup endpoint
        const formData = new FormData();
        formData.append('qr_code', value);
        
        fetch('{{ path("catering_kassa_qr_lookup") }}', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())            .then(data => {
                if (data.success) {
                    feedback.innerHTML = '<span style="color: #28a745;"><i class="fas fa-check"></i> Benutzer gefunden: ' + data.user.nickname + '</span>';
                    
                    // Redirect after short delay with checked URL
                    setTimeout(() => {
                        console.log("Redirecting to:", data.redirect);
                        console.log("User UUID:", data.user.uuid);
                        
                        // Directly construct a valid URL to avoid issues
                        const baseUrl = '{{ path("catering_kassa_products", {"userId": "PLACEHOLDER"}) }}'.replace('PLACEHOLDER', encodeURIComponent(data.user.uuid));
                        console.log("Constructed URL:", baseUrl);
                        
                        // Redirect using the manually constructed URL
                        window.location.href = baseUrl;
                    }, 1000);
                } else {
                    feedback.innerHTML = '<span style="color: #dc3545;"><i class="fas fa-exclamation-triangle"></i> ' + data.message + '</span>';
                    resetButton();
                }
            })
        .catch(error => {
            feedback.innerHTML = '<span style="color: #dc3545;"><i class="fas fa-exclamation-triangle"></i> Fehler bei der Suche</span>';
            resetButton();
        });
    }
    
    function resetButton() {
        qrInput.disabled = false;
        qrInput.value = '';
        qrInput.focus();
    }
    
    // Handle Enter key
    qrInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            if (this.value.trim().length === 4) {
                submitQRCode();
            }
        }
    });
    
    // Session timeout management - DISABLED on scan page (no user session yet)
    // Only active on pages with logged-in users (products, payment, etc.)
    /*
