{% extends 'site/siteBase.html.twig' %}

{% block title %}{{ settings.get('site.title') }} - Tickets & Addons kaufen{% endblock %}

{% block main %}
    <div class="container mb-4">
        <h2>Bestellübersicht</h2>
        <p>Hier findest du deine Bestellungen für Tickets.</p>

        {% set open_orders = orders | filter(o => o.isOpen) %}
        {% set done_orders = orders | filter(o => o.isActive) %}
        <div id="order-list">
        {% if open_orders %}
            <h4 class="pt-3">Offene Bestellungen</h4>
            <p>Offene Bestellungen warten auf deine Zahlung und werden nach Geldeingang bearbeitet.</p>
                {% for o in open_orders %}
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <button class="btn w-100 d-flex" data-toggle="collapse" data-target="#order-{{ o.id }}">
                                    <span>Bestellung <b>#{{ o.id }}</b> vom {{ o.createdAt | date('d.m.y H:i') }}</span>
                                </button>
                            </h5>
                        </div>
                        <div id="order-{{ o.id }}" class="collapse {{ loop.first ? "show" : "" }}" data-parent="#order-list">
                            <div class="card-body">
                                <div>
                                    {% include 'site/shop/_order.html.twig' with { order: o} %}
                                </div>
                                <div class="mb-3">
                                    <p class="mb-2">
                                        Bitte bezahle <strong>{{ (o.calculateTotal() / 100) | format_currency('EUR') }}</strong> unter der Angabe
                                        <strong>Bestellnummer {{ o.id }}</strong> oder deinem <strong>Benutzer-/Gamertag</strong>.
                                    </p>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <div class="border rounded p-3 h-100 bg-light">
                                                <h6 class="text-uppercase text-muted mb-2"><i class="fas fa-university"></i> Zahlung per Überweisung</h6>
                                                <table class="table table-sm mb-2">
                                                    <tbody>
                                                        <tr><th class="pl-0">Empfänger</th><td>Markus Edenhauser</td></tr>
                                                        <tr><th class="pl-0">IBAN</th><td>LT86 3250 0187 3587 6769</td></tr>
                                                        <tr><th class="pl-0">BIC</th><td>REVOLT21</td></tr>
                                                        <tr><th class="pl-0">Verwendungszweck</th><td>{{ app.user.user.nickname }}, Bestellung {{ o.id }}<br>
                                                        {% set orderAmount = (o.calculateTotal() / 100) | number_format(2, '.', '') %}
                                        <img
                                            src="data:image/png;base64,{{ qr_code_data_uri('BCD\n001\n1\nSCT\nREVOLT21\nMarkus Edenhauser\nLT863250018735876769\nEUR' ~ orderAmount ~ '\n\n' ~ app.user.user.nickname ~ ', Bestellung ' ~ o.id)|replace({'data:image/png;base64,': ''}) }}"
                                            alt="SEPA QR für Überweisung"
                                            style="max-width: 200px;"
                                            title="Scan mit Banking-App für schnelle Überweisung"
                                        />
                                        <div class="small text-muted mt-1">SEPA-QR für {{ (o.calculateTotal()/100) | format_currency('EUR') }}</div></td></tr>
                                                    </tbody>
                                                </table>
                                                
                                                <small class="text-muted d-block">Neues Vereinskonto bei Revolut. Litauen (LT) ist korrekt.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <div class="border rounded p-3 h-100 bg-light">
                                                <h6 class="text-uppercase text-muted mb-2"><i class="fab fa-paypal"></i> Zahlung per PayPal</h6>
                                                <table class="table table-sm mb-2">
                                                    <tbody>
                                                        <tr><th class="pl-0">Email</th><td>verein@headshot.at</td></tr>
                                                        <tr><th class="pl-0">Betrag</th><td>{{ (o.calculateTotal() / 100) | format_currency('EUR') }}</td></tr>
                                                        <tr><th class="pl-0">Nachricht</th><td>{{ app.user.user.nickname }}, Bestellung {{ o.id }}</td></tr>
                                                    </tbody>
                                                </table>
                                                <a href="https://paypal.me/kaiserlantirol/{{ (o.calculateTotal()/100) }}EUR" target="_blank" class="btn btn-sm btn-primary mb-2" style="background-color:#0070ba;border-color:#0070ba;">
                                                    <i class="fab fa-paypal"></i> Direkte PayPal Zahlung ({{ (o.calculateTotal()/100) | format_currency('EUR') }})
                                                </a>
                                                <small class="text-muted d-block">Bitte "An Freunde senden" aktivieren um Gebühren zu vermeiden.</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex mt-2">
                                    <div class="flex-fill"></div>
                                    <form id="cancel-order-{{ o.id }}" method="post" action="{{ path('shop_orders') }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_cancel) }}">
                                        <input type="hidden" name="action" value="cancel">
                                        <input type="hidden" name="order-id" value="{{ o.id }}">
                                        <button type="submit" class="btn btn-sm btn-secondary" value="cancel"><i class="fas fa-trash-alt"></i> Bestellung stornieren</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <span class="text-muted">Keine Bestellungen vorhanden.</span>
                {% endfor %}
        {% endif %}
        {% if done_orders %}
            <h4 class="pt-4">Erledigte Bestellungen</h4>
                {% for o in done_orders %}
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <button class="btn w-100 d-flex" data-toggle="collapse" data-target="#order-{{ o.id }}">
                                    <span>Bestellung <b>#{{ o.id }}</b> vom {{ o.createdAt | date('d.m.y H:i') }}</span>
                                    <div class="flex-fill"></div>
                                    {% if o.isActive() %}
                                        <span class="badge badge-primary">abgeschlossen</span>
                                    {% endif %}
                                    {% if o.isDead() %}
                                        <span class="badge badge-secondary">storniert</span>
                                    {% endif %}
                                </button>
                            </h5>
                        </div>
                        <div id="order-{{ o.id }}" class="collapse {{ open_orders is empty and loop.first ? "show" : "" }}" data-parent="#order-list">
                            <div class="card-body">
                                {% include 'site/shop/_order.html.twig' with { order: o} %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <span class="text-muted">Keine Bestellungen vorhanden.</span>
                {% endfor %}
        {% endif %}
        </div>
        {% if not orders and not done_orders %}
            <span class="text-muted">Du hast keine Bestellungen.</span>
        {% endif %}
    </div>
{% endblock %}
